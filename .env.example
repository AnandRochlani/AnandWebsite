# Server-side only (Vercel env). Used by api/public/jobs and api/public/companies proxies.
# Default in code matches production aggregator if unset.
JOBS_API_BASE_URL=https://job-aggregator-d0el.onrender.com

# --- Baba Glass House ERP (/baba) + Admin ---
# Neon / Postgres connection string (the ERP stores all data here).
# Only the URL — no surrounding quotes, no "psql" prefix.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Login credentials + JWT secret (shared by /admin and the /baba ERP login).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_JWT_SECRET=generate-a-long-random-string
